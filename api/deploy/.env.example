# Crear como deploy/.env en el server (nunca commitear el real).
# Estos valores los usa docker-compose.yml (interpolación ${VAR}).

DB_USER=ai_docs
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
# ANTHROPIC_API_KEY se sobreescribe automáticamente en cada deploy desde el
# secret de GitHub Actions del mismo nombre (ver .github/workflows/deploy.yml) —
# rotarla ahí, no hace falta entrar por SSH. Este valor es solo el inicial/fallback.
ANTHROPIC_API_KEY=sk-ant-tu-key-real
CORS_ORIGIN=https://TU_FRONTEND.vercel.app
